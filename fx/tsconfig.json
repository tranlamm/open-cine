{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "paths": {
      "opencine-motion": [
        "./src/motion/kit.tsx"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}
